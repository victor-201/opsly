# Database
# Port 5434: default host mapping for the Docker `db` container (5434:5432).
# A native Windows/Postgres service commonly occupies host port 5432.
DATABASE_URL=postgresql://opsly:opsly@127.0.0.1:5434/opsly

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Encryption
ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# CORS
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Node
NODE_ENV=development
PORT=3000

# Provider API Keys (optional)
# RENDER_API_KEY=
# CLOUDFLARE_API_TOKEN=
# NEON_API_KEY=
# UPSTASH_API_KEY=
# MONGODB_ATLAS_API_KEY=
# MONGODB_ATLAS_PROJECT_ID=
